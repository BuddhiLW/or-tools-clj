{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        metosin/malli {:mvn/version "0.20.3"}
        io.github.hive-agi/hive-dsl {:mvn/version "0.6.1"}
        com.google.ortools/ortools-java {:mvn/version "9.15.6755"}}
 :aliases
 {:examples {:extra-paths ["examples"]
             :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
  :dev {:extra-paths ["test" "examples"]
        :extra-deps {io.github.hive-agi/hive-test {:mvn/version "0.5.2"}
                     nrepl/nrepl {:mvn/version "1.3.1"}}
        :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx1g"]}
  :test {:extra-paths ["test" "examples"]
         :extra-deps {io.github.hive-agi/hive-test {:mvn/version "0.5.2"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx1g"]
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; Clojars publishing. The version is the VERSION file; coordinates are in version.edn.
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.3.1"}}
          :jvm-opts ["-Xmx1g"]
          :ns-default hive-build.api}}}
